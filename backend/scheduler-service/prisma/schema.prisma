// Prisma schema – Scheduler Service
// Only needs models used by reminder and cleanup jobs

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum RepeatType {
  one_time
  daily
  weekly
  monthly
}

// ─── Stubs ────────────────────────────────────────────────────────────────────

model User {
  id    String @id @default(uuid())
  name  String

  reminders    Reminder[]
  deviceTokens DeviceToken[]

  @@map("users")
}

model Conversation {
  id String @id @default(uuid())

  reminders Reminder[]

  @@map("conversations")
}

// ─── Reminder ─────────────────────────────────────────────────────────────────

model Reminder {
  id             String     @id @default(uuid())
  title          String
  note           String?    @db.Text
  datetime       DateTime
  repeat         RepeatType @default(one_time)
  userId         String
  conversationId String?
  visibleTo      Json?
  enabled        Boolean    @default(true)
  notified       Boolean    @default(false)
  notifiedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([datetime, notified, enabled])
  @@map("reminders")
}

model DeviceToken {
  id     String @id @default(uuid())
  userId String
  token  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@map("device_tokens")
}
