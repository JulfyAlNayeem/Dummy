// Prisma schema – Alarm (Alertness) Service

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Stubs ────────────────────────────────────────────────────────────────────

model User {
  id   String @id @default(uuid())
  name String

  alertnessSessionsStarted AlertnessSession[] @relation("AlertnessStarter")
  alertnessResponses       AlertnessResponse[]

  @@map("users")
}

model Conversation {
  id String @id @default(uuid())

  alertnessSessions AlertnessSession[]
  participants      ConversationParticipant[]
  admins            ConversationAdmin[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String @id @default(uuid())
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model ConversationAdmin {
  id             String @id @default(uuid())
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_admins")
}

// ─── Alertness Domain ─────────────────────────────────────────────────────────

model AlertnessSession {
  id                String   @id @default(uuid())
  classId           String
  startedById       String
  duration          Int      @default(30000)  // milliseconds
  isActive          Boolean  @default(true)
  totalParticipants Int      @default(0)
  responseCount     Int      @default(0)
  responseRate      Float?
  endedAt           DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class     Conversation       @relation(fields: [classId], references: [id], onDelete: Cascade)
  startedBy User               @relation("AlertnessStarter", fields: [startedById], references: [id], onDelete: Cascade)
  responses AlertnessResponse[]

  @@index([classId, isActive])
  @@map("alertness_sessions")
}

model AlertnessResponse {
  id         String   @id @default(uuid())
  sessionId  String
  userId     String
  respondedAt DateTime @default(now())

  session AlertnessSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("alertness_responses")
}
