generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id                                                                         String                       @id @default(uuid())
  name                                                                       String                       @unique
  email                                                                      String                       @unique
  password                                                                   String
  gender                                                                     String
  image                                                                      String                       @default("/images/avatar/default-avatar.svg")
  bio                                                                        String?                      @db.VarChar(150)
  role                                                                       UserRole                     @default(user)
  is_active                                                                  Boolean                      @default(false)
  last_seen                                                                  DateTime?
  themeIndex                                                                 Int                          @default(0)
  fileSendingAllowed                                                         Boolean                      @default(false)
  notif_new_message                                                          Boolean?
  notif_mention                                                              Boolean?
  notif_sound                                                                Boolean?
  two_factor_enabled                                                         Boolean                      @default(false)
  two_factor_secret                                                          String?
  is_email_verified                                                          Boolean                      @default(false)
  email_verification_token                                                   String?
  password_reset_token                                                       String?
  password_reset_expires                                                     DateTime?
  refresh_token                                                              String?                      @db.Text
  blocked_at                                                                 DateTime?
  block_reason                                                               String?
  block_duration                                                             String?
  createdAt                                                                  DateTime                     @default(now())
  updatedAt                                                                  DateTime
  cover_image                                                                String?
  website                                                                    String?
  location                                                                   String?
  admin_activity_logs                                                        admin_activity_logs[]
  admin_settings                                                             admin_settings[]
  alertness_responses                                                        alertness_responses[]
  alertnessSessions                                                          AlertnessSession[]           @relation("AlertnessSessionStarter")
  markedAssignments                                                          AssignmentSubmission[]       @relation("MarkedAssignments")
  submittedAssignments                                                       AssignmentSubmission[]       @relation("SubmittedAssignments")
  attendanceLogs                                                             AttendanceLog[]
  blocks_blocks_blockedIdTousers                                             blocks[]                     @relation("blocks_blockedIdTousers")
  blocks_blocks_blockerIdTousers                                             blocks[]                     @relation("blocks_blockerIdTousers")
  bookmarks                                                                  bookmarks[]
  admins                                                                     ConversationAdmin[]
  conversation_block_entries_conversation_block_entries_blockedByIdTousers   conversation_block_entries[] @relation("conversation_block_entries_blockedByIdTousers")
  conversation_block_entries_conversation_block_entries_blockedUserIdTousers conversation_block_entries[] @relation("conversation_block_entries_blockedUserIdTousers")
  moderators                                                                 ConversationModerator[]
  participants                                                               ConversationParticipant[]
  conversation_unreads                                                       conversation_unreads[]
  conversations                                                              Conversation[]
  device_tokens                                                              device_tokens[]
  files                                                                      files[]
  form_assignees                                                             form_assignees[]
  form_assignments                                                           form_assignments[]
  form_submissions                                                           form_submissions[]
  forms                                                                      forms[]
  friend_entries                                                             friend_entries[]
  friend_lists                                                               friend_lists?
  friendships_friendships_recipientIdTousers                                 friendships[]                @relation("friendships_recipientIdTousers")
  friendships_friendships_requesterIdTousers                                 friendships[]                @relation("friendships_requesterIdTousers")
  processedRequests                                                          JoinRequest[]                @relation("JoinProcessor")
  joinRequests                                                               JoinRequest[]                @relation("JoinRequester")
  message_deleted_by                                                         message_deleted_by[]
  message_reactions                                                          message_reactions[]
  message_read_by                                                            message_read_by[]
  messages_messages_receiverIdTousers                                        messages[]                   @relation("messages_receiverIdTousers")
  messages_messages_senderIdTousers                                          messages[]                   @relation("messages_senderIdTousers")
  notice_likes                                                               notice_likes[]
  notice_reads                                                               notice_reads[]
  notices                                                                    notices[]
  notifications_notifications_recipientIdTousers                             notifications[]              @relation("notifications_recipientIdTousers")
  notifications_notifications_senderIdTousers                                notifications[]              @relation("notifications_senderIdTousers")
  page_likes                                                                 page_likes[]
  pages                                                                      pages[]
  permission_requests_permission_requests_requesterIdTousers                 permission_requests[]        @relation("permission_requests_requesterIdTousers")
  permission_requests_permission_requests_reviewedByIdTousers                permission_requests[]        @relation("permission_requests_reviewedByIdTousers")
  post_comment_reactions                                                     post_comment_reactions[]
  post_comment_replies                                                       post_comment_replies[]
  post_comments                                                              post_comments[]
  post_mentions                                                              post_mentions[]
  post_reactions                                                             post_reactions[]
  post_shares                                                                post_shares[]
  posts                                                                      posts[]
  quick_lessons                                                              quick_lessons[]
  quick_messages                                                             quick_messages[]
  reminders                                                                  reminders[]
  reports_reports_reportedUserIdTousers                                      reports[]                    @relation("reports_reportedUserIdTousers")
  reports_reports_reporterIdTousers                                          reports[]                    @relation("reports_reporterIdTousers")
  reports_reports_reviewedByIdTousers                                        reports[]                    @relation("reports_reviewedByIdTousers")
  createdSessions                                                            Session[]                    @relation("SessionCreator")
  social_notifications_social_notifications_receiverIdTousers                social_notifications[]       @relation("social_notifications_receiverIdTousers")
  social_notifications_social_notifications_senderIdTousers                  social_notifications[]       @relation("social_notifications_senderIdTousers")
  stories                                                                    stories[]
  story_views                                                                story_views[]
  unread_counts                                                              unread_counts?
  unread_messages                                                            unread_messages[]
  user_approvals_user_approvals_reviewedByIdTousers                          user_approvals[]             @relation("user_approvals_reviewedByIdTousers")
  user_approvals_user_approvals_userIdTousers                                user_approvals?              @relation("user_approvals_userIdTousers")
  user_deletion_schedules_user_deletion_schedules_preventedByIdTousers       user_deletion_schedules[]    @relation("user_deletion_schedules_preventedByIdTousers")
  user_deletion_schedules_user_deletion_schedules_userIdTousers              user_deletion_schedules[]    @relation("user_deletion_schedules_userIdTousers")

  @@map("users")
}

model Conversation {
  id                         String                            @id @default(uuid())
  status                     ConversationStatus                @default(pending)
  visibility                 Visibility                        @default(public)
  themeIndex                 Int                               @default(0)
  isGroup                    Boolean                           @default(false) @map("is_group")
  groupType                  GroupType?                        @map("group_type")
  groupName                  String?                           @map("group_name")
  groupIntro                 String?                           @map("group_intro") @db.Text
  groupImage                 String                            @default("/images/cover/default-cover.jpg") @map("group_image")
  class_type                 conversations_class_type          @default(regular)
  file_sending_allowed       Boolean                           @default(false)
  start_time                 String                            @default("09:00")
  cutoff_time                String                            @default("09:15")
  check_interval             Int                               @default(15)
  permText                   Boolean                           @default(true) @map("perm_text")
  permImage                  Boolean                           @default(true) @map("perm_image")
  permVoice                  Boolean                           @default(false) @map("perm_voice")
  permVideo                  Boolean                           @default(false) @map("perm_video")
  permFile                   Boolean                           @default(false) @map("perm_file")
  perm_sticker               Boolean                           @default(true)
  perm_gif                   Boolean                           @default(true)
  last_message_text          String?                           @db.Text
  last_message_sender_id     String?
  last_message_timestamp     DateTime?
  auto_delete_messages_after Int                               @default(24)
  key_exchange_status        conversations_key_exchange_status @default(none)
  key_exchange_data          Json?
  key_exchange_created_at    DateTime?
  key_exchange_last_activity DateTime?
  v1_keys                    Json?
  smte_key_version           Int                               @default(0)
  createdAt                  DateTime                          @default(now())
  updatedAt                  DateTime                          @updatedAt
  alertnessSessions          AlertnessSession[]
  assignmentSubmissions      AssignmentSubmission[]
  attendanceLogs             AttendanceLog[]
  admins                     ConversationAdmin[]
  conversation_block_entries conversation_block_entries[]
  moderators                 ConversationModerator[]
  participants               ConversationParticipant[]
  selectedDays               ConversationSelectedDay[]
  conversation_unreads       conversation_unreads[]
  users                      User?                             @relation(fields: [last_message_sender_id], references: [id])
  files                      files[]
  form_assignments           form_assignments[]
  joinRequests               JoinRequest[]
  messages                   messages[]
  permission_requests        permission_requests[]
  quick_lessons              quick_lessons[]
  reminders                  reminders[]
  reports                    reports[]
  sessions                   Session[]
  unread_messages            unread_messages[]

  @@index([visibility])
  @@index([groupType])
  @@index([last_message_sender_id], map: "conversations_last_message_sender_id_fkey")
  @@map("conversations")
}

model ClassProfile {
  id                 String    @id @default(uuid())
  conversationId     String    @unique
  classType          ClassType @default(regular) @map("class_type")
  fileSendingAllowed Boolean   @default(false) @map("file_sending_allowed")
  startTime          String    @default("09:00") @map("start_time")
  cutoffTime         String    @default("09:15") @map("cutoff_time")
  checkInterval      Int       @default(15) @map("check_interval")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  @@map("class_profiles")
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model ConversationAdmin {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId], map: "conversation_admins_userId_fkey")
  @@map("conversation_admins")
}

model ConversationModerator {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId], map: "conversation_moderators_userId_fkey")
  @@map("conversation_moderators")
}

model ConversationSelectedDay {
  id             String       @id @default(uuid())
  conversationId String
  day            Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, day])
  @@map("conversation_selected_days")
}

model JoinRequest {
  id            String            @id @default(uuid())
  classId       String
  userId        String
  status        JoinRequestStatus @default(pending)
  requestedAt   DateTime          @default(now())
  processedAt   DateTime?
  processedById String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  class         Conversation      @relation(fields: [classId], references: [id], onDelete: Cascade)
  processedBy   User?             @relation("JoinProcessor", fields: [processedById], references: [id])
  user          User              @relation("JoinRequester", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classId, userId])
  @@index([status])
  @@index([processedById], map: "join_requests_processedById_fkey")
  @@index([userId], map: "join_requests_userId_fkey")
  @@map("join_requests")
}

model Session {
  id             String          @id @default(uuid())
  classId        String
  date           String
  startTime      String
  type           SessionType     @default(auto)
  createdById    String?
  status         SessionStatus   @default(scheduled)
  duration       Int             @default(70)
  cutoffTime     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  attendanceLogs AttendanceLog[]
  conversation   Conversation    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("SessionCreator", fields: [createdById], references: [id])

  @@unique([classId, date, startTime])
  @@index([status])
  @@index([createdById], map: "sessions_createdById_fkey")
  @@map("sessions")
}

model AlertnessSession {
  id                  String                @id @default(uuid())
  classId             String
  startedById         String
  duration            Int
  startTime           DateTime              @default(now())
  endTime             DateTime?
  isActive            Boolean               @default(true)
  totalParticipants   Int                   @default(0)
  responseRate        Float                 @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  alertness_responses alertness_responses[]
  class               Conversation          @relation(fields: [classId], references: [id], onDelete: Cascade)
  startedBy           User                  @relation("AlertnessSessionStarter", fields: [startedById], references: [id], onDelete: Cascade)

  @@index([classId, startTime])
  @@index([isActive])
  @@index([startedById], map: "alertness_sessions_startedById_fkey")
  @@map("alertness_sessions")
}

model AttendanceLog {
  id          String           @id @default(uuid())
  sessionId   String
  classId     String
  userId      String
  status      AttendanceStatus @default(absent)
  enteredAt   DateTime?
  leftAt      DateTime?
  duration    Int?
  sessionDate String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  class       Conversation     @relation(fields: [classId], references: [id], onDelete: Cascade)
  session     Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId, sessionDate])
  @@index([enteredAt])
  @@index([classId], map: "attendance_logs_classId_fkey")
  @@index([userId], map: "attendance_logs_userId_fkey")
  @@map("attendance_logs")
}

model AssignmentSubmission {
  id                    String       @id @default(uuid())
  classId               String
  userId                String
  assignmentTitle       String
  assignmentDescription String       @db.Text
  status                String       @default("pending")
  file_url              String?
  file_name             String?
  file_size             Int?
  file_type             String?
  mark                  Int?         @db.SmallInt
  markedById            String?
  markedAt              DateTime?
  feedback              String?      @db.Text
  submittedAt           DateTime     @default(now())
  class                 Conversation @relation(fields: [classId], references: [id], onDelete: Cascade)
  markedBy              User?        @relation("MarkedAssignments", fields: [markedById], references: [id])
  user                  User         @relation("SubmittedAssignments", fields: [userId], references: [id], onDelete: Cascade)

  @@index([classId, userId])
  @@index([submittedAt])
  @@index([markedById], map: "assignment_submissions_markedById_fkey")
  @@index([userId], map: "assignment_submissions_userId_fkey")
  @@map("assignment_submissions")
}

model admin_activity_logs {
  id         String                         @id
  adminId    String
  action     String
  targetType admin_activity_logs_targetType
  targetId   String?
  details    Json?
  user_agent String?
  severity   admin_activity_logs_severity   @default(low)
  createdAt  DateTime                       @default(now())
  updatedAt  DateTime
  users      User                           @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId], map: "admin_activity_logs_adminId_fkey")
}

model admin_allowed_file_types {
  id              String         @id
  adminSettingsId String
  fileType        String
  admin_settings  admin_settings @relation(fields: [adminSettingsId], references: [id], onDelete: Cascade)

  @@index([adminSettingsId], map: "admin_allowed_file_types_adminSettingsId_fkey")
}

model admin_blocked_words {
  id              String         @id
  adminSettingsId String
  word            String
  admin_settings  admin_settings @relation(fields: [adminSettingsId], references: [id], onDelete: Cascade)

  @@index([adminSettingsId], map: "admin_blocked_words_adminSettingsId_fkey")
}

model admin_settings {
  id                               String                     @id
  feat_voice_messages              Boolean                    @default(true)
  feat_sms_notif                   Boolean                    @default(true)
  feat_image_sharing               Boolean                    @default(true)
  feat_video_sharing               Boolean                    @default(true)
  feat_file_sharing                Boolean                    @default(true)
  feat_voice_calling               Boolean                    @default(true)
  feat_video_calling               Boolean                    @default(true)
  feat_group_creation              Boolean                    @default(true)
  feat_user_registration           Boolean                    @default(true)
  sec_require_admin_approval       Boolean                    @default(true)
  sec_auto_approve_after_hours     Int                        @default(24)
  sec_max_file_size_mb             Int                        @default(50)
  sec_message_encryption           Boolean                    @default(true)
  sec_two_factor_required          Boolean                    @default(false)
  sec_session_timeout_minutes      Int                        @default(60)
  mod_auto_moderate                Boolean                    @default(false)
  mod_max_message_length           Int                        @default(1000)
  mod_spam_detection               Boolean                    @default(true)
  mod_image_content_filter         Boolean                    @default(false)
  rl_messages_per_minute           Int                        @default(30)
  rl_files_per_hour                Int                        @default(10)
  rl_friend_requests_per_day       Int                        @default(20)
  rl_group_creation_per_day        Int                        @default(5)
  notif_admin_email_alerts         Boolean                    @default(true)
  notif_new_user_notifications     Boolean                    @default(true)
  notif_suspicious_activity_alerts Boolean                    @default(true)
  notif_system_maintenance_mode    Boolean                    @default(false)
  updatedById                      String
  createdAt                        DateTime                   @default(now())
  updatedAt                        DateTime
  admin_allowed_file_types         admin_allowed_file_types[]
  admin_blocked_words              admin_blocked_words[]
  users                            User                       @relation(fields: [updatedById], references: [id], onDelete: Cascade)

  @@index([updatedById], map: "admin_settings_updatedById_fkey")
}

model alertness_responses {
  id                 String           @id
  alertnessSessionId String
  userId             String
  respondedAt        DateTime         @default(now())
  responseTime       Int?
  alertness_sessions AlertnessSession @relation(fields: [alertnessSessionId], references: [id], onDelete: Cascade)
  users              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([alertnessSessionId, userId])
  @@index([userId], map: "alertness_responses_userId_fkey")
}

model blocks {
  id                            String   @id
  blockerId                     String
  blockedId                     String
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime
  users_blocks_blockedIdTousers User     @relation("blocks_blockedIdTousers", fields: [blockedId], references: [id], onDelete: Cascade)
  users_blocks_blockerIdTousers User     @relation("blocks_blockerIdTousers", fields: [blockerId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId], map: "blocks_blockedId_fkey")
}

model bookmarks {
  id        String   @id
  userId    String
  postId    String
  createdAt DateTime @default(now())
  posts     posts    @relation(fields: [postId], references: [id], onDelete: Cascade)
  users     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId], map: "bookmarks_postId_fkey")
  @@index([userId, createdAt])
}

model conversation_block_entries {
  id                                                    String       @id
  conversationId                                        String
  blockedById                                           String
  blockedUserId                                         String
  blockedAt                                             DateTime     @default(now())
  users_conversation_block_entries_blockedByIdTousers   User         @relation("conversation_block_entries_blockedByIdTousers", fields: [blockedById], references: [id], onDelete: Cascade)
  users_conversation_block_entries_blockedUserIdTousers User         @relation("conversation_block_entries_blockedUserIdTousers", fields: [blockedUserId], references: [id], onDelete: Cascade)
  conversations                                         Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, blockedById, blockedUserId])
  @@index([blockedById], map: "conversation_block_entries_blockedById_fkey")
  @@index([blockedUserId], map: "conversation_block_entries_blockedUserId_fkey")
}

model conversation_unreads {
  id             String       @id
  conversationId String
  userId         String
  count          Int          @default(0)
  conversations  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  users          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId], map: "conversation_unreads_userId_fkey")
}

model device_tokens {
  id     String @id
  userId String
  token  String
  users  User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
}

model files {
  id            String        @id
  filename      String
  originalName  String
  mimetype      String
  size          Int
  path          String
  uploadedById  String
  classId       String?
  description   String?       @db.Text
  isPublic      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  conversations Conversation? @relation(fields: [classId], references: [id])
  users         User          @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([classId])
  @@index([createdAt])
  @@index([uploadedById])
}

model follows {
  id          String   @id
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

model form_assignees {
  id               String           @id
  formAssignmentId String
  userId           String
  form_assignments form_assignments @relation(fields: [formAssignmentId], references: [id], onDelete: Cascade)
  users            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([formAssignmentId, userId])
  @@index([userId], map: "form_assignees_userId_fkey")
}

model form_assignments {
  id               String                     @id
  formId           String
  conversationId   String
  assignerId       String
  frequency        form_assignments_frequency
  startDate        DateTime                   @default(now())
  isActive         Boolean                    @default(true)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime
  form_assignees   form_assignees[]
  users            User                       @relation(fields: [assignerId], references: [id], onDelete: Cascade)
  conversations    Conversation               @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  forms            forms                      @relation(fields: [formId], references: [id], onDelete: Cascade)
  form_submissions form_submissions[]

  @@index([assignerId])
  @@index([conversationId, isActive])
  @@index([formId])
}

model form_fields {
  id                      String                    @id
  formId                  String
  label                   String                    @db.VarChar(500)
  type                    form_fields_type
  order                   Int
  forms                   forms                     @relation(fields: [formId], references: [id], onDelete: Cascade)
  form_submission_answers form_submission_answers[]

  @@index([formId], map: "form_fields_formId_fkey")
}

model form_submission_answers {
  id               String                               @id
  submissionId     String
  fieldId          String
  value            String                               @db.Text
  explanation      String                               @default("") @db.VarChar(2000)
  reviewStatus     form_submission_answers_reviewStatus @default(pending)
  reviewNote       String                               @default("") @db.VarChar(500)
  form_fields      form_fields                          @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  form_submissions form_submissions                     @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([fieldId], map: "form_submission_answers_fieldId_fkey")
  @@index([submissionId], map: "form_submission_answers_submissionId_fkey")
}

model form_submissions {
  id                      String                    @id
  assignmentId            String
  submitterId             String
  dueDate                 DateTime
  status                  form_submissions_status   @default(submitted)
  reviewedAt              DateTime?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime
  form_submission_answers form_submission_answers[]
  form_assignments        form_assignments          @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  users                   User                      @relation(fields: [submitterId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, submitterId, dueDate])
  @@index([assignmentId, dueDate])
  @@index([submitterId, status])
}

model forms {
  id               String             @id
  name             String             @db.VarChar(200)
  creatorId        String
  visibility       forms_visibility   @default(private)
  isArchived       Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime
  form_assignments form_assignments[]
  form_fields      form_fields[]
  users            User               @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId, isArchived])
  @@index([visibility, isArchived])
}

model friend_entries {
