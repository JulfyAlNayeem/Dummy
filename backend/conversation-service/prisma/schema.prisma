generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── User Stub (owned by root-service) ───────────────────────────────────────

model User {
  id                   String                       @id
  conversations        Conversation[]
  admins               ConversationAdmin[]
  moderators           ConversationModerator[]
  participants         ConversationParticipant[]
  conversation_unreads conversation_unreads[]
  conversation_block_entries_blocker conversation_block_entries[] @relation("BlockedBy")
  conversation_block_entries_blocked conversation_block_entries[] @relation("BlockedUser")
  joinRequests         JoinRequest[]                @relation("JoinRequester")
  processedRequests    JoinRequest[]                @relation("JoinProcessor")
  createdSessions      Session[]                    @relation("SessionCreator")
  attendanceLogs       AttendanceLog[]
  alertnessSessions    AlertnessSession[]           @relation("AlertnessSessionStarter")
  alertness_responses  alertness_responses[]
  submittedAssignments AssignmentSubmission[]        @relation("SubmittedAssignments")
  markedAssignments    AssignmentSubmission[]        @relation("MarkedAssignments")
  messages_sent        messages[]                   @relation("MessageSender")
  messages_received    messages[]                   @relation("MessageReceiver")
  message_reactions    message_reactions[]
  message_read_by      message_read_by[]
  message_deleted_by   message_deleted_by[]
  quick_lessons        quick_lessons[]
  reminders            reminders[]
  permission_requests  permission_requests[]        @relation("PermissionRequester")
  permission_reviews   permission_requests[]        @relation("PermissionReviewer")
  reports_submitted    reports[]                    @relation("Reporter")
  reports_received     reports[]                    @relation("ReportedUser")
  report_reviews       reports[]                    @relation("ReportReviewer")
  unread_counts        unread_counts?
  unread_messages      unread_messages[]
  device_tokens        device_tokens[]

  @@map("users")
}

// ─── Conversation ─────────────────────────────────────────────────────────────

model Conversation {
  id                         String                            @id @default(uuid())
  status                     ConversationStatus                @default(pending)
  visibility                 Visibility                        @default(public)
  themeIndex                 Int                               @default(0)
  isGroup                    Boolean                           @default(false) @map("is_group")
  groupType                  GroupType?                        @map("group_type")
  groupName                  String?                           @map("group_name")
  groupIntro                 String?                           @map("group_intro") @db.Text
  groupImage                 String                            @default("/images/cover/default-cover.jpg") @map("group_image")
  class_type                 conversations_class_type          @default(regular)
  file_sending_allowed       Boolean                           @default(false)
  start_time                 String                            @default("09:00")
  cutoff_time                String                            @default("09:15")
  check_interval             Int                               @default(15)
  permText                   Boolean                           @default(true) @map("perm_text")
  permImage                  Boolean                           @default(true) @map("perm_image")
  permVoice                  Boolean                           @default(false) @map("perm_voice")
  permVideo                  Boolean                           @default(false) @map("perm_video")
  permFile                   Boolean                           @default(false) @map("perm_file")
  perm_sticker               Boolean                           @default(true)
  perm_gif                   Boolean                           @default(true)
  last_message_text          String?                           @db.Text
  last_message_sender_id     String?
  last_message_timestamp     DateTime?
  auto_delete_messages_after Int                               @default(24)
  key_exchange_status        conversations_key_exchange_status @default(none)
  key_exchange_data          Json?
  key_exchange_created_at    DateTime?
  key_exchange_last_activity DateTime?
  v1_keys                    Json?
  smte_key_version           Int                               @default(0)
  createdAt                  DateTime                          @default(now())
  updatedAt                  DateTime                          @updatedAt

  last_message_sender        User?                             @relation(fields: [last_message_sender_id], references: [id])
  admins                     ConversationAdmin[]
  moderators                 ConversationModerator[]
  participants               ConversationParticipant[]
  selectedDays               ConversationSelectedDay[]
  conversation_unreads       conversation_unreads[]
  conversation_block_entries conversation_block_entries[]
  joinRequests               JoinRequest[]
  sessions                   Session[]
  alertnessSessions          AlertnessSession[]
  attendanceLogs             AttendanceLog[]
  assignmentSubmissions      AssignmentSubmission[]
  messages                   messages[]
  quick_lessons              quick_lessons[]
  reminders                  reminders[]
  permission_requests        permission_requests[]
  reports                    reports[]
  unread_messages            unread_messages[]

  @@index([visibility])
  @@index([groupType])
  @@index([last_message_sender_id], map: "conversations_last_message_sender_id_fkey")
  @@map("conversations")
}

// ─── Conversation Members ─────────────────────────────────────────────────────

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model ConversationAdmin {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId], map: "conversation_admins_userId_fkey")
  @@map("conversation_admins")
}

model ConversationModerator {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId], map: "conversation_moderators_userId_fkey")
  @@map("conversation_moderators")
}

model ConversationSelectedDay {
  id             String       @id @default(uuid())
  conversationId String
  day            Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, day])
  @@map("conversation_selected_days")
}

model conversation_block_entries {
  id            String       @id @default(uuid())
  conversationId String
  blockedById   String
  blockedUserId String
  blockedAt     DateTime     @default(now())
  conversation  Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  blockedBy     User         @relation("BlockedBy", fields: [blockedById], references: [id], onDelete: Cascade)
  blockedUser   User         @relation("BlockedUser", fields: [blockedUserId], references: [id], onDelete: Cascade)

  @@unique([conversationId, blockedById, blockedUserId])
  @@index([blockedById], map: "conversation_block_entries_blockedById_fkey")
  @@index([blockedUserId], map: "conversation_block_entries_blockedUserId_fkey")
  @@map("conversation_block_entries")
}

model conversation_unreads {
  id             String       @id @default(uuid())
  conversationId String
  userId         String
  count          Int          @default(0)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId], map: "conversation_unreads_userId_fkey")
  @@map("conversation_unreads")
}

// ─── Join Requests ────────────────────────────────────────────────────────────

model JoinRequest {
  id            String            @id @default(uuid())
  classId       String
  userId        String
  status        JoinRequestStatus @default(pending)
  requestedAt   DateTime          @default(now())
  processedAt   DateTime?
  processedById String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  class         Conversation      @relation(fields: [classId], references: [id], onDelete: Cascade)
  user          User              @relation("JoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  processedBy   User?             @relation("JoinProcessor", fields: [processedById], references: [id])

  @@unique([classId, userId])
  @@index([status])
  @@index([processedById], map: "join_requests_processedById_fkey")
  @@index([userId], map: "join_requests_userId_fkey")
  @@map("join_requests")
}

// ─── Sessions & Attendance ────────────────────────────────────────────────────

model Session {
  id             String          @id @default(uuid())
  classId        String
  date           String
  startTime      String
  type           SessionType     @default(auto)
  createdById    String?
  status         SessionStatus   @default(scheduled)
  duration       Int             @default(70)
  cutoffTime     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  conversation   Conversation    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("SessionCreator", fields: [createdById], references: [id])
  attendanceLogs AttendanceLog[]

  @@unique([classId, date, startTime])
  @@index([status])
  @@index([createdById], map: "sessions_createdById_fkey")
  @@map("sessions")
}

model AttendanceLog {
  id          String           @id @default(uuid())
  sessionId   String
  classId     String
  userId      String
  status      AttendanceStatus @default(absent)
  enteredAt   DateTime?
  leftAt      DateTime?
  duration    Int?
  sessionDate String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  session     Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  class       Conversation     @relation(fields: [classId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId, sessionDate])
  @@index([enteredAt])
  @@index([classId], map: "attendance_logs_classId_fkey")
  @@index([userId], map: "attendance_logs_userId_fkey")
  @@map("attendance_logs")
}

model AlertnessSession {
  id                  String                @id @default(uuid())
  classId             String
  startedById         String
  duration            Int
  startTime           DateTime              @default(now())
  endTime             DateTime?
  isActive            Boolean               @default(true)
  totalParticipants   Int                   @default(0)
  responseRate        Float                 @default(0)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  class               Conversation          @relation(fields: [classId], references: [id], onDelete: Cascade)
  startedBy           User                  @relation("AlertnessSessionStarter", fields: [startedById], references: [id], onDelete: Cascade)
  alertness_responses alertness_responses[]

  @@index([classId, startTime])
  @@index([isActive])
  @@index([startedById], map: "alertness_sessions_startedById_fkey")
  @@map("alertness_sessions")
}

model alertness_responses {
  id                 String           @id @default(uuid())
  alertnessSessionId String
  userId             String
  respondedAt        DateTime         @default(now())
  responseTime       Int?
  alertness_sessions AlertnessSession @relation(fields: [alertnessSessionId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([alertnessSessionId, userId])
  @@index([userId], map: "alertness_responses_userId_fkey")
  @@map("alertness_responses")
}

model AssignmentSubmission {
  id                    String       @id @default(uuid())
  classId               String
  userId                String
  assignmentTitle       String
  assignmentDescription String       @db.Text
  status                String       @default("pending")
  file_url              String?
  file_name             String?
  file_size             Int?
  file_type             String?
  mark                  Int?         @db.SmallInt
  markedById            String?
  markedAt              DateTime?
  feedback              String?      @db.Text
  submittedAt           DateTime     @default(now())
  class                 Conversation @relation(fields: [classId], references: [id], onDelete: Cascade)
  user                  User         @relation("SubmittedAssignments", fields: [userId], references: [id], onDelete: Cascade)
  markedBy              User?        @relation("MarkedAssignments", fields: [markedById], references: [id])

  @@index([classId, userId])
  @@index([submittedAt])
  @@index([markedById], map: "assignment_submissions_markedById_fkey")
  @@index([userId], map: "assignment_submissions_userId_fkey")
  @@map("assignment_submissions")
}

// ─── Messages ─────────────────────────────────────────────────────────────────

model messages {
  id                    String                 @id @default(uuid())
  conversationId        String
  senderId              String
  receiverId            String?
  text                  String?                @db.Text
  isEncrypted           Boolean                @default(false)
  isBackendEncrypted    Boolean                @default(false)
  messageType           messages_messageType   @default(text)
  htmlEmoji             String?                @db.Text
  emojiType             messages_emojiType?
  replyToId             String?
  status                messages_status        @default(sent)
  edited                Boolean                @default(false)
  scheduledDeletionTime DateTime?
  reactions             Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  conversation         Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender               User                   @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver             User?                  @relation("MessageReceiver", fields: [receiverId], references: [id])
  replyTo              messages?              @relation("MessageReplies", fields: [replyToId], references: [id])
  replies              messages[]             @relation("MessageReplies")
  message_deleted_by   message_deleted_by[]
  message_edit_history message_edit_history[]
  message_media        message_media[]
  message_reactions    message_reactions[]
  message_read_by      message_read_by[]

  @@index([conversationId, createdAt])
  @@index([emojiType])
  @@index([messageType])
  @@index([receiverId], map: "messages_receiverId_fkey")
  @@index([replyToId], map: "messages_replyToId_fkey")
  @@index([scheduledDeletionTime])
  @@index([senderId])
  @@map("messages")
}

model message_deleted_by {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  message   messages @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId], map: "message_deleted_by_userId_fkey")
  @@map("message_deleted_by")
}

model message_edit_history {
  id        String   @id @default(uuid())
  messageId String
  text      String   @db.Text
  editedAt  DateTime @default(now())
  message   messages @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId], map: "message_edit_history_messageId_fkey")
  @@map("message_edit_history")
}

model message_media {
  id        String              @id @default(uuid())
  messageId String
  url       String?
  type      message_media_type?
  filename  String?
  size      Int?
  message   messages            @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId], map: "message_media_messageId_fkey")
  @@map("message_media")
}

model message_reactions {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  emoji     String
  username  String
  message   messages @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([userId], map: "message_reactions_userId_fkey")
  @@map("message_reactions")
}

model message_read_by {
  id        String   @id @default(uuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   messages @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId], map: "message_read_by_userId_fkey")
  @@map("message_read_by")
}

// ─── Unread Tracking ──────────────────────────────────────────────────────────

model unread_counts {
  id                       String            @id @default(uuid())
  userId                   String            @unique
  unreadFriendRequestCount Int               @default(0)
  unreadGroupRequestCount  Int               @default(0)
  unreadClassRequestCount  Int               @default(0)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  user                     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  unread_messages          unread_messages[]

  @@map("unread_counts")
}

model unread_messages {
  id             String        @id @default(uuid())
  unreadCountId  String
  conversationId String
  userId         String
  count          Int           @default(0)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "unread_message_user_fk")
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  unread_counts  unread_counts @relation(fields: [unreadCountId], references: [id], onDelete: Cascade)

  @@unique([unreadCountId, conversationId])
  @@index([conversationId])
  @@index([userId])
  @@map("unread_messages")
}

// ─── Quick Lessons ────────────────────────────────────────────────────────────

model quick_lessons {
  id                 String               @id @default(uuid())
  userId             String
  conversationId     String
  lessonName         String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation       Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  quick_lesson_parts quick_lesson_parts[]

  @@index([conversationId], map: "quick_lessons_conversationId_fkey")
  @@index([userId], map: "quick_lessons_userId_fkey")
  @@map("quick_lessons")
}

model quick_lesson_parts {
  id            String        @id @default(uuid())
  quickLessonId String
  content       String        @db.Text
  order         Int
  quick_lesson  quick_lessons @relation(fields: [quickLessonId], references: [id], onDelete: Cascade)

  @@index([quickLessonId], map: "quick_lesson_parts_quickLessonId_fkey")
  @@map("quick_lesson_parts")
}


// ─── Permission Requests ──────────────────────────────────────────────────────

model permission_requests {
  id             String                             @id @default(uuid())
  conversationId String
  requesterId    String
  permissionType permission_requests_permissionType
  reason         String                             @default("") @db.VarChar(500)
  status         permission_requests_status         @default(pending)
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String                             @default("") @db.VarChar(500)
  createdAt      DateTime                           @default(now())
  updatedAt      DateTime                           @updatedAt
  conversation   Conversation                       @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requester      User                               @relation("PermissionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  reviewedBy     User?                              @relation("PermissionReviewer", fields: [reviewedById], references: [id])

  @@index([conversationId, requesterId, status])
  @@index([requesterId], map: "permission_requests_requesterId_fkey")
  @@index([reviewedById], map: "permission_requests_reviewedById_fkey")
  @@index([status, createdAt])
  @@map("permission_requests")
}

// ─── Reports ──────────────────────────────────────────────────────────────────

model reports {
  id             String              @id @default(uuid())
  reporterId     String
  reportedUserId String?
  conversationId String
  reason         reports_reason
  details        String              @default("") @db.VarChar(2000)
  status         reports_status      @default(pending)
  reviewedById   String?
  reviewedAt     DateTime?
  resolution     String              @default("") @db.VarChar(500)
  actionTaken    reports_actionTaken @default(none)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  reporter       User                @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser   User?               @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reviewedBy     User?               @relation("ReportReviewer", fields: [reviewedById], references: [id])

  @@index([conversationId], map: "reports_conversationId_fkey")
  @@index([createdAt])
  @@index([reportedUserId])
  @@index([reporterId, conversationId])
  @@index([reviewedById], map: "reports_reviewedById_fkey")
  @@index([status])
  @@map("reports")
}

// ─── Device Tokens ────────────────────────────────────────────────────────────

model device_tokens {
  id     String @id @default(uuid())
  userId String
  token  String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@map("device_tokens")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum ConversationStatus {
  pending
  accepted
  rejected
}

enum Visibility {
  public
  private
}

enum GroupType {
  group
  classroom
}

enum conversations_class_type {
  regular
  weekly
  multi_weekly @map("multi-weekly")
  monthly
  exam
}

enum conversations_key_exchange_status {
  none
  pending
  partial
  complete
}

enum JoinRequestStatus {
  pending
  approved
  rejected
}

enum SessionType {
  auto
  manual
}

enum SessionStatus {
  scheduled
  ongoing
  completed
}

enum AttendanceStatus {
  present
  late
  absent
  excused
}

enum messages_messageType {
  text
  image
  video
  audio
  file
  system
  reply
  mixed
}

enum messages_emojiType {
  custom
  standard
}

enum messages_status {
  sent
  delivered
  read
}

enum message_media_type {
  image
  video
  audio
  file
}

enum reminders_repeat {
  one_time @map("one-time")
  daily
  weekly
  monthly
}

enum reminders_visibleTo {
  creator
  both
}

enum permission_requests_permissionType {
  text
  image
  voice
  video
  file
  sticker
  gif
}

enum permission_requests_status {
  pending
  approved
  rejected
}

enum reports_reason {
  spam
  harassment
  hate_speech
  violence
  nudity
  false_info
  impersonation
  other
}

enum reports_status {
  pending
  reviewed
  resolved
  dismissed
}

enum reports_actionTaken {
  none
  warning
  temporary_ban
  permanent_ban
  content_removed
}