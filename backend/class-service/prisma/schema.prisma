// Prisma schema – Class Service
// Owns: Conversation (groupType=classroom), Session, AttendanceLog, JoinRequest
// Stub: User (read-only)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ClassType {
  regular
  weekly
  multi_weekly @map("multi-weekly")
  monthly
  exam
}

enum GroupType {
  group
  classroom
}

enum Visibility {
  public
  private
}

enum ConversationStatus {
  pending
  accepted
  rejected
}

enum JoinRequestStatus {
  pending
  approved
  rejected
}

enum UserRole {
  user
  admin
  superadmin
  moderator
  teacher
}

// ─── Read-only stubs ─────────────────────────────────────────────────────────

model User {
  id    String   @id @default(uuid())
  name  String
  image String   @default("/images/avatar/default-avatar.svg")
  role  UserRole @default(user)

  participants      ConversationParticipant[]
  admins            ConversationAdmin[]
  moderators        ConversationModerator[]
  joinRequests      JoinRequest[]  @relation("JoinRequester")
  processedRequests JoinRequest[]  @relation("JoinProcessor")
  attendanceLogs    AttendanceLog[]
  sessions          Session[]

  @@map("users")
}

// ─── Conversation (classroom) ─────────────────────────────────────────────────

model Conversation {
  id           String             @id @default(uuid())
  status       ConversationStatus @default(pending)
  visibility   Visibility         @default(public)
  isGroup      Boolean            @default(false)  @map("is_group")
  groupType    GroupType?         @map("group_type")
  groupName    String?            @map("group_name")
  groupIntro   String?            @map("group_intro") @db.Text
  groupImage   String             @default("/images/cover/default-cover.jpg") @map("group_image")
  classType    ClassType          @default(regular)  @map("class_type")
  startTime    String             @default("09:00")  @map("start_time")
  cutoffTime   String             @default("09:15")  @map("cutoff_time")
  checkInterval Int               @default(15)       @map("check_interval")
  fileSendingAllowed Boolean      @default(false)    @map("file_sending_allowed")

  permText     Boolean @default(true)  @map("perm_text")
  permImage    Boolean @default(true)  @map("perm_image")
  permVoice    Boolean @default(false) @map("perm_voice")
  permVideo    Boolean @default(false) @map("perm_video")
  permFile     Boolean @default(false) @map("perm_file")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants  ConversationParticipant[]
  admins        ConversationAdmin[]
  moderators    ConversationModerator[]
  selectedDays  ConversationSelectedDay[]
  joinRequests  JoinRequest[]
  sessions      Session[]
  attendanceLogs AttendanceLog[]

  @@index([visibility])
  @@index([groupType])
  @@map("conversations")
}

model ConversationParticipant {
  id             String @id @default(uuid())
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_participants")
}

model ConversationAdmin {
  id             String @id @default(uuid())
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_admins")
}

model ConversationModerator {
  id             String @id @default(uuid())
  conversationId String
  userId         String

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_moderators")
}

model ConversationSelectedDay {
  id             String @id @default(uuid())
  conversationId String
  day            Int

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, day])
  @@map("conversation_selected_days")
}

// ─── JoinRequest ─────────────────────────────────────────────────────────────

model JoinRequest {
  id            String            @id @default(uuid())
  classId       String
  userId        String
  status        JoinRequestStatus @default(pending)
  requestedAt   DateTime          @default(now())
  processedAt   DateTime?
  processedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class       Conversation @relation(fields: [classId], references: [id], onDelete: Cascade)
  user        User         @relation("JoinRequester", fields: [userId], references: [id], onDelete: Cascade)
  processedBy User?        @relation("JoinProcessor", fields: [processedById], references: [id], onDelete: SetNull)

  @@unique([classId, userId])
  @@index([status])
  @@map("join_requests")
}

// ─── Session ─────────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(uuid())
  classId   String
  date      String
  startTime String
  endTime   String?
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  class         Conversation    @relation(fields: [classId], references: [id], onDelete: Cascade)
  attendanceLogs AttendanceLog[]
  students       User[]

  @@unique([classId, date])
  @@map("sessions")
}

// ─── AttendanceLog ───────────────────────────────────────────────────────────

model AttendanceLog {
  id             String   @id @default(uuid())
  sessionId      String
  userId         String
  conversationId String
  status         String   @default("present")
  joinedAt       DateTime @default(now())
  leftAt         DateTime?

  session      Session      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
  @@map("attendance_logs")
}
