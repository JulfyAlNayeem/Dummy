# Social Frontend Dockerfile for Production
FROM node:24-alpine AS build

ARG VITE_API_URL=/api
ARG VITE_BASE_PATH=/social

WORKDIR /app

RUN npm install -g pnpm

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .pnpmrc* ./
COPY frontend/social/package.json ./frontend/social/

RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter alfajr-social --ignore-scripts

RUN pnpm --filter alfajr-social rebuild esbuild

COPY frontend/social/ ./frontend/social/

WORKDIR /app/frontend/social

RUN echo "VITE_API_URL=${VITE_API_URL}" > .env && \
    echo "VITE_BASE_PATH=${VITE_BASE_PATH}" >> .env

RUN pnpm run build

RUN if [ -d dist ]; then ls -la dist; else echo "ERROR: build output not found (dist/)" >&2; exit 1; fi

FROM nginx:alpine

COPY --from=build /app/frontend/social/dist /usr/share/nginx/html
COPY --from=build /app/frontend/social/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
